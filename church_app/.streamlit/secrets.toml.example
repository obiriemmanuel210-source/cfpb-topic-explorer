# Copy to .streamlit/secrets.toml (local) or paste into the
# Streamlit Community Cloud "Secrets" box. Never commit the real file.

church_name = "Grace Chapel"
currency = "GH₵ "
timezone = "Africa/Accra"
phone_country_code = "233"

# Needed once, to create the first admin account. Use a long random value.
setup_key = "replace-with-a-long-random-phrase"

# Leave out to use a local SQLite file (fine on your own computer).
# For hosting online, use your Supabase "Session pooler" connection string:
# database_url = "postgresql://postgres.abcd1234:YOUR-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Printed on PDF giving statements
church_details = "P.O. Box 1, Accra · 030 000 0000 · info@gracechapel.org"
statement_signatory = "Church Treasurer"

# SMS through mNotify (leave out to disable sending)
# mnotify_api_key = "your-mnotify-api-key"
# sms_sender_id = "GRACECHAPEL"
